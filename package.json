{
  "name": "leitstellen-sim-v2",
  "version": "0.5.4",
  "description": "Browserbasierte Leitstellen-Simulation als Desktop-App",
  "type": "module",
  "main": "electron-main.mjs",
  "scripts": {
    "start": "electron .",
    "server": "node server.mjs",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "dist:dir": "electron-builder --dir",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "de.leitstellen-simulation.sim-v2",
    "productName": "Leitstellen-SIM",
    "files": [
      "**/*",
      "!server.out.log",
      "!server.err.log",
      "!.env",
      "!.env.*",
      "!test-admin.local.js",
      "!*.local.js",
      "!Leitstellen-SIM-vor-TNA-*.zip",
      "!mods/**",
      "!mod-settings.json",
      "!mod-data/**",
      "!mod-catalogs/**",
      "!node_modules/.cache/**",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "mods/manv",
        "to": "builtin-mods/manv",
        "filter": ["manifest.json", "main.mjs", "scenarios.json", "README.md"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "42.1.0",
    "electron-builder": "26.8.1"
  }
}
